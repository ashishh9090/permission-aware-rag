# Application & Security Settings
PROJECT_NAME="Permission-Aware Multi-Tenant RAG"
SECRET_KEY="enterprise-super-secure-secret-key-change-in-production-123456"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local Standalone (Default zero-dependency testing):
DATABASE_URL="sqlite:///./rag_platform.db"
# Docker / Production PostgreSQL + pgvector:
# DATABASE_URL="postgresql+psycopg2://postgres:postgrespassword@localhost:5432/rag_db"

# LLM Gateway
# When USE_MOCK_LLM is true, the system operates deterministically without external API costs or internet
USE_MOCK_LLM=true
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Retrieval & Caching Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
SIMILARITY_THRESHOLD=0.35
TOP_K_CHUNKS=5
HYBRID_ALPHA=0.6
